{
  "manifest_version": 3,
  "name": "Slopblock",
  "version": "2.0.0",
  "description": "Automatically blocks every member of the X lists you choose.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    { "matches": ["https://x.com/i/lists/*"], "js": ["hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://x.com/i/lists/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
